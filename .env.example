# Required in production. Use a long random value; never commit .env.local.
PAYLOAD_SECRET=
# Local staging default: file:./data/rm-hungary.db
DATABASE_URL=file:./data/rm-hungary.db
# Set to postgres to use the PostgreSQL adapter.
DATABASE_ADAPTER=sqlite
# Required when DATABASE_ADAPTER=postgres.
# DATABASE_URL=postgres://user:password@host:5432/rm_hungary
